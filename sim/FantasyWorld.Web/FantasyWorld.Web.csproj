<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    The world in a browser (sub-project 11 W2): the same Sim and Client code as the game and the film, compiled to
    WebAssembly, answering the page's questions about the day's world over JS interop. Read-only; no native code (the
    world comes as a JSON bundle, not the SQLite file).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- The sim's JSON is read by reflection, which needs the nullability metadata a trimmed browser build turns off. -->
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.31" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FantasyWorld.Client\FantasyWorld.Client.csproj" />
  </ItemGroup>

  <!--
    The viewer never asks an LLM: only the game's Session uses the provider SDK, so the trimmer may drop what is unused
    of the client, the LLM project and the SDK (about 8 MB). The sim itself is kept whole: its JSON is read by reflection.
  -->
  <ItemGroup>
    <TrimmableAssembly Include="FantasyWorld.Client" />
    <TrimmableAssembly Include="FantasyWorld.Llm" />
    <TrimmableAssembly Include="Anthropic" />
  </ItemGroup>

</Project>
